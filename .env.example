# 复制为 .env 后填写。.env 已被 .gitignore 排除，真实密钥不要写进本文件。

# --- 数据库（docker compose 读取 POSTGRES_PASSWORD）
POSTGRES_PASSWORD=
DATABASE_URL=postgres://ai_finance:<POSTGRES_PASSWORD>@127.0.0.1:5434/ai_finance

# --- 访问保护（缺少任一项时，受保护页面拒绝访问而不是免登录）
OWNER_USERNAME=
# Argon2id 哈希：填 npm run hash-password 输出的整行（其中 $ 已转义为 \$，Next.js 读取 .env 时会展开未转义的 $）
OWNER_PASSWORD_HASH=
# 至少 32 个字符，可用 openssl rand -hex 32 生成
SESSION_SECRET=
# 只有在 Nginx 反向代理后运行时设为 true，才信任 X-Forwarded-For
TRUST_PROXY=false

# --- 数据来源（缺少密钥的来源显示未配置，不发请求）
FRED_API_KEY=
BEA_API_KEY=
FINNHUB_API_KEY=
TIINGO_API_KEY=
# SEC 要求注明用途与联系邮箱，例如 "ai-finance personal research you@example.com"
SEC_USER_AGENT=
